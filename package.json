{
  "name": "cartepro",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run db:up && turbo run dev",
    "start": "bun run db:up && turbo run start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml}\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "db:up": "bun scripts/db.ts up",
    "db:down": "bun scripts/db.ts down",
    "db:nuke": "bun scripts/db.ts nuke",
    "db:status": "bun scripts/db.ts status",
    "db:shell": "bun scripts/db.ts shell",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.0.1",
    "chalk": "^6.0.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.3.13"
}
