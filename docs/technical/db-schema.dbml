Project cartepro_db {
  Note: '''
  CartePro database schema, as it exists on a fresh database: migrated with
  `bun run --filter '@tickettout/backend' db:migrate` (17 migrations) and
  seeded with `db:seed`, then introspected with `pg_dump --schema-only` and
  converted to DBML via `@dbml/cli`'s postgres importer. Generated 2026-09-10.

  `account`, `api_key`, `rate_limit`, `session`, `user` and `verification` are
  Better Auth's own tables, not application entities.

  CHECK constraints and the ledger tables' immutability triggers
  (`prevent_money_table_mutation`) are not expressible in DBML; they are
  recorded as a Note on each table they apply to instead.
  '''
}

Enum "allocation_status_enum" {
  "draft"
  "applied"
}

Enum "audit_log_action_enum" {
  "account_created"
  "account_updated"
  "role_changed"
  "partner_approved"
  "partner_refused"
  "allocation_applied"
  "transaction_approved"
  "transaction_refused"
  "login_failed"
  "admin_action"
}

Enum "partner_review_from_status_enum" {
  "pending"
  "active"
  "refused"
  "banned"
}

Enum "partner_review_to_status_enum" {
  "pending"
  "active"
  "refused"
  "banned"
}

Enum "partner_status_enum" {
  "pending"
  "active"
  "refused"
  "banned"
}

Enum "payment_capture_mode_enum" {
  "qr_code"
  "manual_code"
}

Enum "payment_status_enum" {
  "validated"
  "refused"
}

Enum "payment_token_status_enum" {
  "live"
  "consumed"
  "revoked"
}

Enum "wallet_entry_direction_enum" {
  "credit"
  "debit"
}

Enum "wallet_entry_kind_enum" {
  "payment_sent"
  "payment_received"
  "refund_sent"
  "refund_received"
  "allocation_received"
}

Enum "wallet_status_enum" {
  "active"
  "disabled"
}

Table "account" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "issuer" text [not null]
  "account_id" text [not null]
  "provider_id" text [not null]
  "password" text
  "access_token" text
  "refresh_token" text
  "id_token" text
  "access_token_expires_at" timestamptz
  "refresh_token_expires_at" timestamptz
  "scope" text
  "user_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (issuer, account_id) [unique, name: "account_issuer_account_id_uidx"]
    user_id [type: btree, name: "IDX_efef1e5fdbe318a379c06678c5"]
  }
}

Table "allocation" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "label" text [not null]
  "amount" numeric(12,2) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "employer_id" uuid [not null]
  "created_by" uuid [not null]
  "status" allocation_status_enum [not null, default: `'draft'::public.allocation_status_enum`]
  "applied_at" timestamptz
  Indexes {
    employer_id [type: btree, name: "IDX_allocation_employer_id"]
  }

  Note: '''
Rows are immutable once "status" = 'applied' (UPDATE blocked by trigger TRG_allocation_immutable_once_applied) and can never be deleted (TRG_allocation_no_delete).
CHK_allocation_amount_positive: (amount > (0)::numeric)
CHK_allocation_applied_at_matches_status: ((status = 'applied'::public.allocation_status_enum) = (applied_at IS NOT NULL))
  '''
}

Table "api_key" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "config_id" text [not null, default: `'default'::text`]
  "name" text
  "key" text [not null]
  "start" text
  "prefix" text
  "reference_id" text [not null]
  "enabled" boolean [default: true]
  "refill_interval" integer
  "refill_amount" integer
  "last_refill_at" timestamptz
  "remaining" integer
  "rate_limit_enabled" boolean [default: true]
  "rate_limit_time_window" integer [default: 86400000]
  "rate_limit_max" integer [default: 10]
  "request_count" integer [default: 0]
  "last_request" timestamptz
  "expires_at" timestamptz
  "permissions" text
  "metadata" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    reference_id [type: btree, name: "IDX_3d78c51b8caa59b4b0aec8418d"]
    config_id [type: btree, name: "IDX_e1ecbaeacf87ee61fe10c33140"]
    key [type: btree, name: "IDX_fb080786c16de6ace7ed0b69f7"]
  }
}

Table "audit_log" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "occurred_at" timestamptz [not null, default: `now()`]
  "actor_id" uuid
  "actor_role" text
  "action" audit_log_action_enum [not null]
  "target_type" text [not null]
  "target_id" text
  "payload" jsonb
  "ip" text
  "previous_hash" text
  "hash" text [not null]

  Indexes {
    action [type: btree, name: "IDX_audit_log_action"]
    actor_id [type: btree, name: "IDX_audit_log_actor_id"]
    occurred_at [type: btree, name: "IDX_audit_log_occurred_at"]
  }
}

Table "employer" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "name" text [not null]
  "siren" character(9) [unique, not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "migrations" {
  "id" integer [pk, not null]
  "timestamp" bigint [not null]
  "name" varchar [not null]
}

Table "partner" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "legal_name" text [not null]
  "trade_name" text [not null]
  "siren" character(9) [unique, not null]
  "business_purpose" text [not null]
  "status" partner_status_enum [not null, default: `'pending'::public.partner_status_enum`]
  "address_line" text [not null]
  "postal_code" text [not null]
  "city" text [not null]
  "latitude" numeric(9,6) [not null]
  "longitude" numeric(9,6) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "owner_id" uuid [unique, not null]
}

Table "partner_category" {
  "slug" text [pk, not null]
  "display_name" text [not null]
}

Table "partner_review" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "from_status" partner_review_from_status_enum [not null]
  "to_status" partner_review_to_status_enum [not null]
  "reason" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "partner_id" uuid [not null]
  "decided_by" uuid [not null]
  Indexes {
    partner_id [type: btree, name: "IDX_partner_application_partner_id"]
  }

  Note: '''
Rows are immutable: no UPDATE or DELETE (trigger TRG_partner_review_immutable). Corrections are new rows, never edits.
CHK_partner_review_reason_not_blank: (length(btrim(reason)) > 0)
  '''
}

Table "partner_to_category" {
  "partner_id" uuid [not null]
  "category_slug" text [not null]

  Indexes {
    (partner_id, category_slug) [pk, name: "PK_3c5a4dce278726dca0eea386ae8"]
    partner_id [type: btree, name: "IDX_7caabe483ddd70a09fa83da6ee"]
    category_slug [type: btree, name: "IDX_a6d8550715cd3df77bd7f8e9db"]
  }
}

Table "payment" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "amount" numeric(12,2) [not null]
  "capture_mode" payment_capture_mode_enum [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "wallet_id" uuid [not null]
  "partner_id" uuid [not null]
  "payment_token_id" uuid [unique, not null]
  "status" payment_status_enum [not null, default: `'validated'::public.payment_status_enum`]
  "partner_reference" text
  Indexes {
    created_at [type: btree, name: "IDX_payment_created_at"]
    partner_id [type: btree, name: "IDX_payment_partner_id"]
    wallet_id [type: btree, name: "IDX_payment_wallet_id"]
  }

  Note: '''
Rows are immutable: no UPDATE or DELETE (trigger TRG_payment_immutable). Refused payments and refunds are new rows, never edits.
CHK_payment_amount_positive: (amount > (0)::numeric)
CHK_payment_partner_reference_not_blank: ((partner_reference IS NULL) OR (length(btrim(partner_reference)) > 0))
  '''
}

Table "payment_token" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "short_code" character(8) [not null]
  "status" payment_token_status_enum [not null, default: `'live'::public.payment_token_status_enum`]
  "expires_at" timestamptz [not null]
  "consumed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "wallet_id" uuid [not null]

  Indexes {
    short_code [type: btree, unique, name: "IDX_e0929abab7954045fa56b68db7"]
    wallet_id [type: btree, name: "IDX_payment_token_wallet_id"]
  }
}

Table "rate_limit" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "key" text [unique, not null]
  "count" integer [not null]
  "last_request" bigint [not null]
}

Table "session" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "token" text [unique, not null]
  "expires_at" timestamptz [not null]
  "ip_address" text
  "user_agent" text
  "impersonated_by" text
  "user_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [type: btree, name: "IDX_30e98e8746699fb9af235410af"]
  }
}

Table "user" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "name" text [not null]
  "email" text [unique, not null]
  "email_verified" boolean [not null, default: false]
  "image" text
  "role" text
  "banned" boolean [default: false]
  "ban_reason" text
  "ban_expires" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "verification" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "identifier" text [not null]
  "value" text [not null]
  "expires_at" timestamptz [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    identifier [type: btree, name: "IDX_896e5902333fa9991d1733e5ee"]
  }
}

Table "wallet" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "employee_ref" text
  "balance" numeric(12,2) [not null, default: `'0'::numeric`]
  "currency" character(3) [not null, default: `'EUR'::bpchar`]
  "status" wallet_status_enum [not null, default: `'active'::public.wallet_status_enum`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "user_id" uuid [not null]
  "employer_id" uuid
  Indexes {
    (employer_id, employee_ref) [type: btree, unique, name: "IDX_wallet_employer_employee_ref"]
    employer_id [type: btree, name: "IDX_wallet_employer_id"]
    (user_id, employer_id) [type: btree, unique, name: "IDX_wallet_user_employer"]
    user_id [type: btree, name: "IDX_wallet_user_id"]
    user_id [type: btree, unique, name: "IDX_wallet_user_no_employer"]
  }

  Note: '''
CHK_wallet_balance_non_negative: (balance >= (0)::numeric)
  '''
}

Table "wallet_entry" {
  "id" uuid [pk, not null, default: `uuidv7()`]
  "direction" wallet_entry_direction_enum [not null]
  "amount" numeric(12,2) [not null]
  "balance_after" numeric(12,2) [not null]
  "kind" wallet_entry_kind_enum [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "wallet_id" uuid [not null]
  "payment_id" uuid
  "allocation_id" uuid
  Indexes {
    allocation_id [type: btree, name: "IDX_wallet_entry_allocation_id"]
    (allocation_id, wallet_id) [type: btree, unique, name: "IDX_wallet_entry_allocation_wallet"]
    payment_id [type: btree, name: "IDX_wallet_entry_payment_id"]
    wallet_id [type: btree, name: "IDX_wallet_entry_wallet_id"]
  }

  Note: '''
Rows are immutable: no UPDATE or DELETE (trigger TRG_wallet_entry_immutable). The ledger is append-only.
CHK_wallet_entry_amount_positive: (amount > (0)::numeric)
  '''
}

