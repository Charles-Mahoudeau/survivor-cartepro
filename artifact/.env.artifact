NODE_ENV=production

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=cartepro
DATABASE_PASSWORD=cartepro
DATABASE_NAME=cartepro
DATABASE_LOGGING=true

# The host Traefik answers on. Its origin is trusted by the API, and its scheme
# decides whether the session cookie is Secure — over plain http it must not be.
BETTER_AUTH_URL=http://cartepro.localhost
AUTH_TRUSTED_ORIGINS=http://cartepro.localhost
