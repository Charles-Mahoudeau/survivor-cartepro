{
  "name": "@tickettout/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix",
    "typegen": "next typegen",
    "typecheck": "bun run typegen && tsc --noEmit",
    "lint:check": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "test": "bun test",
    "test:unit": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.3.1",
    "@codegouvfr/react-dsfr": "^1.34.0",
    "@hookform/resolvers": "^5.9.1",
    "@remixicon/react": "^4.9.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "16.3.4",
    "next-safe-action": "^8.7.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.0"
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
