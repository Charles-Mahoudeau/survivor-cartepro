# Copier en .env et ajuster. Les valeurs ci-dessous correspondent à
# docker/compose.yml : un checkout neuf démarre avec ce fichier copié tel quel.
#
# DB_PORT vaut 5434 et non le 5432 standard : c'est aussi le port hôte que
# compose expose, et 5432 est presque toujours pris par une autre base locale.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=cartepro
DB_PASSWORD=cartepro
DB_DATABASE=cartepro

# Passer à false pour couper le log des requêtes TypeORM.
DB_LOGGING=true
