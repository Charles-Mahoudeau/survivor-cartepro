{
  "name": "@cartepro/api",
  "version": "0.0.1",
  "description": "API CartePro — avantages salariés dématérialisés",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "NODE_ENV=production bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,scripts}/**/*.ts\"",
    "format": "prettier --write \"{src,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.ts\"",
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "docs:openapi": "bun scripts/generate-openapi.ts",
    "typeorm": "bunx --bun typeorm -d src/config/database/data-source.ts",
    "db:generate": "bun scripts/db-generate.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:revert": "bun scripts/db-revert.ts",
    "db:show": "bun scripts/db-show.ts",
    "db:drop": "bun scripts/db-drop.ts",
    "db:reset": "bun scripts/db-reset.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "chalk": "^6.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
